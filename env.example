# Copy to `.env`. Read by docker compose (service configuration) and by the application
# (`Settings`, variables prefixed EMBLEMA_). These values run the local stack only.

# Artifact store: the Garage bucket of the local stack. Compose maps this key onto Garage's
# default key and MLflow's S3 client, so credentials are defined in one place.
# Every published port is addressed by IPv4 literal: compose publishes on 127.0.0.1 only, and
# `localhost` reaches ::1 first - whatever answers there is not this stack.
EMBLEMA_ARTIFACT_STORE__ENDPOINT_URL=http://127.0.0.1:3900
EMBLEMA_ARTIFACT_STORE__REGION=garage
EMBLEMA_ARTIFACT_STORE__BUCKET=emblema
EMBLEMA_ARTIFACT_STORE__KEY_PREFIX=dev
# Garage key ids start with GK followed by hexadecimal digits; the secret is 64 hexadecimal digits.
EMBLEMA_ARTIFACT_STORE__ACCESS_KEY=GK6f1a2b3c4d5e6f708192a3b4c5d6e7f8
EMBLEMA_ARTIFACT_STORE__SECRET_KEY=3b8f0c2e5d7a9c1f4e6b8d0a2c4e6f8091a3b5c7d9e1f3a5b7c9d1e3f5a7b9c1

# Bootstrap job: endpoint as seen from inside the compose network, prefixes to install lifecycle
# rules for, and the age at which transient artifacts (intermediate checkpoints) expire.
BOOTSTRAP_ENDPOINT_URL=http://garage:3900
ARTIFACT_ENVIRONMENT_PREFIXES="dev test"
TRANSIENT_RETENTION_DAYS=7

# Metadata database: the Postgres of the local stack. Compose creates the database and its role
# from these variables and the application connects with them, so they are defined in one place
# and nothing has a fallback. The host port is the one compose publishes. The password reaches
# MLflow inside a connection URL, so keep it to URL-safe characters: percent encoding it here
# would change the password Postgres itself is created with. A process that only trains — a
# notebook fulfilling a pretraining order — has no registry to reach and leaves all five unset.
EMBLEMA_DATABASE__HOST=127.0.0.1
EMBLEMA_DATABASE__PORT=5432
EMBLEMA_DATABASE__NAME=emblema
EMBLEMA_DATABASE__USER=emblema
EMBLEMA_DATABASE__PASSWORD=emblema

# Queue: the RabbitMQ of the local stack, which background work passes through. Nothing has a
# fallback, as with the database. A lost message costs a resubmission, because how far a campaign
# got is in the database, not in the queue. A process that runs everything where it was asked
# leaves all five unset. The vhost is the broker's own default, written as one character.
EMBLEMA_BROKER__HOST=127.0.0.1
EMBLEMA_BROKER__PORT=5672
EMBLEMA_BROKER__USER=emblema
EMBLEMA_BROKER__PASSWORD=emblema
EMBLEMA_BROKER__VHOST=/

# The campaign worker, whether it runs in the stack or on the host beside an accelerator. Every
# other process leaves the whole group unset, and the worker in the stack stays behind a profile
# until these are filled in: a worker told none of them refuses to start.
# The backbone is written key@algorithm:digest, as the registry holds it; the device defaults to
# whatever accelerator the machine has, which inside the stack is the processor. The schedule and
# the low-rank updates have no defaults: how long every arm learns and how strongly it may be
# updated is what the comparison is about, so a worker that was told neither refuses to start
# rather than measure something nobody declared. The values below are the configuration in
# force in docs/preregistration.md, the rate being the peak of the arm trained from scratch; check
# them against that file before a run whose numbers are meant to count.
# EMBLEMA_WORKER__WORKSPACE=data/workspace
# EMBLEMA_WORKER__CORPORA=data/raw
# EMBLEMA_WORKER__BACKBONE="durable/<key>@sha256:<digest>"
# EMBLEMA_WORKER__DEVICE=mps
# EMBLEMA_WORKER__SCHEDULE__EPOCHS=30
# EMBLEMA_WORKER__SCHEDULE__MIN_STEPS=2000
# EMBLEMA_WORKER__SCHEDULE__BATCH_SIZE=16
# EMBLEMA_WORKER__SCHEDULE__LEARNING_RATE=1e-3
# EMBLEMA_WORKER__SCHEDULE__WEIGHT_DECAY=0.0
# EMBLEMA_WORKER__SCHEDULE__WARMUP_FRACTION=0.1
# EMBLEMA_WORKER__SCHEDULE__FINAL_LR_FRACTION=0.01
# EMBLEMA_WORKER__LORA__RANK=8
# EMBLEMA_WORKER__LORA__ALPHA=16.0
# EMBLEMA_WORKER__LORA__DROPOUT=0.0
# EMBLEMA_WORKER__LORA__TARGETS=qkv,attention.projection,feedforward
# The patch model, read by the same worker and trained under the schedule above, so it spends the
# budget the arms spend. The encoder is the small tier's shape (width, heads, layers, feed-forward),
# under two million weights over a turbofan window, which a test holds it to; patch and stride are
# those of a window of fifty cycles, and the grid has one step per unit of the corpus's time, as
# MiniRocket's has.
# EMBLEMA_WORKER__PATCH__PATCH_LENGTH=8
# EMBLEMA_WORKER__PATCH__STRIDE=4
# EMBLEMA_WORKER__PATCH__WIDTH=192
# EMBLEMA_WORKER__PATCH__HEADS=3
# EMBLEMA_WORKER__PATCH__LAYERS=4
# EMBLEMA_WORKER__PATCH__FEEDFORWARD_WIDTH=768
# EMBLEMA_WORKER__PATCH__DROPOUT=0.2
# EMBLEMA_WORKER__PATCH__GRID_RESOLUTION=1.0
# How hard the classical candidates fit. Read by the worker of the `general` queue; the one
# that trains networks has no use for them, as that one has no use for the schedule above.
# The values are the library's own defaults — a baseline runs as its method was published unless a
# declared selection chooses otherwise (docs/preregistration.md). The threads are part of what a
# fit answers, not a dial of convenience: a histogram is summed in the order the work was split in.
# EMBLEMA_WORKER__BOOSTING__ROUNDS=100
# EMBLEMA_WORKER__BOOSTING__MAX_DEPTH=6
# EMBLEMA_WORKER__BOOSTING__LEARNING_RATE=0.3
# EMBLEMA_WORKER__BOOSTING__ROW_SHARE=1.0
# EMBLEMA_WORKER__BOOSTING__FEATURE_SHARE=1.0
# EMBLEMA_WORKER__BOOSTING__MIN_LEAF_WEIGHT=1.0
# EMBLEMA_WORKER__BOOSTING__L2_PENALTY=1.0
# EMBLEMA_WORKER__BOOSTING__THREADS=4
# MiniRocket, read by the same worker: features in whole multiples of its 84 kernels and the
# ridge penalties it chooses among. The grid a window is laid on is not configured: it has one
# step per unit of the corpus's time. Threads for the reason the trees have them.
# EMBLEMA_WORKER__CONVOLUTIONS__FEATURES=9996
# EMBLEMA_WORKER__CONVOLUTIONS__RIDGE_PENALTIES=0.001,0.00464,0.0215,0.1,0.464,2.15,10,46.4,215,1000
# EMBLEMA_WORKER__CONVOLUTIONS__THREADS=4

# Host ports, when the defaults collide with something already running. On macOS 5000 is usually
# taken by AirPlay Receiver. Moving the Garage port means moving the endpoint with it: the
# application reaches the store through the published port, while BOOTSTRAP_ENDPOINT_URL stays on
# the compose network.
# GARAGE_S3_PORT=3900
# MLFLOW_PORT=5000

# Remote bucket (Cloudflare R2). Keep these in `.env.r2`, never in `.env`, and point the same
# code at them by configuration alone:
#   uv run --env-file .env.r2 pytest -m integration tests/shared/ports/test_artifact_store_contract.py
#   docker compose --env-file .env.r2 run --rm --no-deps bootstrap
#
# EMBLEMA_ARTIFACT_STORE__ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# EMBLEMA_ARTIFACT_STORE__REGION=auto
# EMBLEMA_ARTIFACT_STORE__BUCKET=emblema
# EMBLEMA_ARTIFACT_STORE__KEY_PREFIX=test
# EMBLEMA_ARTIFACT_STORE__ACCESS_KEY=<R2 access key id>
# EMBLEMA_ARTIFACT_STORE__SECRET_KEY=<R2 secret access key>
# BOOTSTRAP_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# ARTIFACT_ENVIRONMENT_PREFIXES="dev test"
# TRANSIENT_RETENTION_DAYS=7
# EMBLEMA_DATABASE__HOST=unused
# EMBLEMA_DATABASE__PORT=5432
# EMBLEMA_DATABASE__NAME=unused
# EMBLEMA_DATABASE__USER=unused
# EMBLEMA_DATABASE__PASSWORD=unused
# EMBLEMA_BROKER__HOST=unused
# EMBLEMA_BROKER__PORT=5672
# EMBLEMA_BROKER__USER=unused
# EMBLEMA_BROKER__PASSWORD=unused
# EMBLEMA_BROKER__VHOST=/
#
# Set every EMBLEMA_ variable in that file. One left out falls back to `.env`, and the run would
# quietly exercise the local stack while claiming to have reached the remote bucket. The database
# variables are there because `--env-file` replaces `.env` entirely and compose interpolates the
# whole file before it knows you asked for one service; the bootstrap job never opens a database.
